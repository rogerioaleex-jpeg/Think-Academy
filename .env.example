# ============================================================================
# Think IT Cyber Academy — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versione o .env real.
# ============================================================================

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL="postgresql://tica:tica@localhost:5432/tica?schema=public"

# ---- API ----
API_PORT=3333
NODE_ENV=development
# Segredo do JWT — troque por um valor forte e único (>= 32 chars) em produção.
# O boot FALHA em produção se este valor estiver ausente/default/curto.
JWT_SECRET="troque-este-segredo-em-producao"
# Validade do ACCESS token (curta — o refresh token renova automaticamente).
JWT_EXPIRES_IN="15m"
# Origem do frontend liberada no CORS (aceita lista separada por vírgula)
WEB_ORIGIN="http://localhost:3000"

# ---- Cookies de autenticação (access/refresh token httpOnly) ----
# SameSite: lax (padrão) | strict | none. Use 'none' SOMENTE com HTTPS quando
# frontend e API estiverem em sites diferentes (exige Secure, ligado em prod).
COOKIE_SAMESITE=lax
# Domínio do cookie (deixe vazio para o host atual; ex.: .thinkit.academy em prod)
COOKIE_DOMAIN=

# ---- Object Storage (abstração) ----
# provider: minio | s3 | azure | r2
STORAGE_PROVIDER=minio
STORAGE_BUCKET=tica-media
# Tempo de validade das signed URLs de vídeo/material (segundos)
STORAGE_SIGNED_URL_TTL=900

# MinIO / S3 / R2 (compatíveis com S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Azure Blob (usado quando STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=

# ---- Redis (cache / filas / ranking) ----
REDIS_URL="redis://localhost:6379"

# ---- Labs (orquestração) ----
# driver: docker | kubernetes | vm
LAB_DRIVER=docker
# Nome da rede Docker isolada dedicada aos labs (SEM acesso à rede corporativa)
LAB_NETWORK=tica-labs-isolated
LAB_DEFAULT_TIMEOUT_MIN=60

# ---- SSO / Microsoft Entra ID (preparado para fase futura) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI="http://localhost:3333/auth/oidc/callback"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3333"
