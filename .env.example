# ============================================================================
# Think IT Cyber Academy — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versione o .env real.
# ============================================================================

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL="postgresql://tica:tica@localhost:5432/tica?schema=public"

# ---- API ----
API_PORT=3333
NODE_ENV=development
# Segredo do JWT — troque por um valor forte e único (>= 32 chars) em produção.
# O boot FALHA em produção se este valor estiver ausente/default/curto.
JWT_SECRET="troque-este-segredo-em-producao"
# Validade do ACCESS token (curta — o refresh token renova automaticamente).
JWT_EXPIRES_IN="15m"
# Origem do frontend liberada no CORS (aceita lista separada por vírgula)
WEB_ORIGIN="http://localhost:3000"

# ---- Cookies de autenticação (access/refresh token httpOnly) ----
# SameSite: lax (padrão) | strict | none. Use 'none' SOMENTE com HTTPS quando
# frontend e API estiverem em sites diferentes (exige Secure, ligado em prod).
COOKIE_SAMESITE=lax
# Domínio do cookie (deixe vazio para o host atual; ex.: .thinkit.academy em prod)
COOKIE_DOMAIN=

# ---- Object Storage (abstração) ----
# provider: minio | s3 | azure | r2
STORAGE_PROVIDER=minio
STORAGE_BUCKET=tica-media
# Tempo de validade das signed URLs de vídeo/material (segundos)
STORAGE_SIGNED_URL_TTL=900

# MinIO / S3 / R2 (compatíveis com S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Azure Blob (usado quando STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=

# ---- Redis (cache / filas / ranking) ----
REDIS_URL="redis://localhost:6379"

# ---- Labs (orquestração) ----
# driver: docker | kubernetes | vm
LAB_DRIVER=docker
# Nome da rede Docker isolada dedicada aos labs (SEM acesso à rede corporativa)
LAB_NETWORK=tica-labs-isolated
LAB_DEFAULT_TIMEOUT_MIN=60

# ---- Labs de VM completa (Windows 10 / Ubuntu Desktop via noVNC) ----
# Ver infra/labs/README.md — essas VMs rodam num host dedicado com KVM,
# separado do Render.
# traefik-labels (padrão e OBRIGATÓRIO com a rede isolada — validado em
#   produção real: redes Docker internal:true não publicam portas, então é
#   o único modo que expõe a VM sem abrir mão do isolamento) | direct-port
#   (usa `docker port`; só funciona se LAB_NETWORK apontar para uma rede
#   NÃO internal — ou seja, só serve para teste local sem garantia de
#   isolamento, NUNCA em conjunto com tica-labs-isolated)
LAB_VM_ACCESS_MODE=traefik-labels
LAB_VM_HOST=localhost                      # host/IP alcançável quando LAB_VM_ACCESS_MODE=direct-port
LAB_PUBLIC_DOMAIN=                         # domínio wildcard quando LAB_VM_ACCESS_MODE=traefik-labels

# Docker remoto (host dedicado com KVM) — só necessário se a API não rodar
# fisicamente no mesmo host do Docker dos labs (ex.: API no Render).
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=

# Gateway RDP-via-navegador (labs com osType terminando em _RDP, ex.:
# UBUNTU_DESKTOP_RDP) — ver infra/labs/README.md pra montar o Guacamole no
# host dedicado. GUACAMOLE_ADMIN_PASSWORD NUNCA deve ficar no padrão
# "guacadmin" em produção — troque via API assim que o schema for aplicado.
GUACAMOLE_URL=                             # ex.: https://guac.labs.seudominio.com.br/guacamole
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASSWORD=

# ---- SSO / Microsoft Entra ID (preparado para fase futura) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI="http://localhost:3333/auth/oidc/callback"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3333"
